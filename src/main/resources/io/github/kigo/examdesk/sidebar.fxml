<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.kigo.examdesk.SidebarController" styleClass="sidebar">

    <!-- 画面に表示しないオブジェクトを宣言し、$navGroup で参照する -->
    <fx:define>
        <ToggleGroup fx:id="navGroup"/>
    </fx:define>

    <HBox styleClass="brand" spacing="10" alignment="CENTER_LEFT">
        <StackPane styleClass="brand-mark">
            <SVGPath styleClass="brand-icon" content="M7 4 H15 L19 8 V20 H7 Z M10 13 L12 15 L16 10"/>
        </StackPane>
        <VBox>
            <Label styleClass="brand-title" text="ExamDesk"/>
            <Label styleClass="brand-sub" text="解答・自己採点ノート"/>
        </VBox>
    </HBox>

    <ToggleButton styleClass="nav-button" text="ホーム" userData="HOME" toggleGroup="$navGroup" maxWidth="Infinity">
        <graphic>
            <SVGPath styleClass="nav-icon" content="M3 11 L12 4 L21 11 M5.5 9.5 V20 H18.5 V9.5 M10 20 V14 H14 V20"/>
        </graphic>
    </ToggleButton>
    <ToggleButton fx:id="sheetButton" styleClass="nav-button" text="解答用紙" userData="SHEET" toggleGroup="$navGroup" maxWidth="Infinity">
        <graphic>
            <SVGPath styleClass="nav-icon" content="M6 3 H15 L19 7 V21 H6 Z M9 10 H16 M9 14 H16 M9 18 H13"/>
        </graphic>
    </ToggleButton>
    <ToggleButton styleClass="nav-button" text="結果一覧" userData="RESULTS" toggleGroup="$navGroup" maxWidth="Infinity">
        <graphic>
            <SVGPath styleClass="nav-icon" content="M4 20 H20 M7 16 V11 M12 16 V6 M17 16 V9"/>
        </graphic>
    </ToggleButton>
    <ToggleButton styleClass="nav-button" text="設定" userData="SETTINGS" toggleGroup="$navGroup" maxWidth="Infinity">
        <graphic>
            <SVGPath styleClass="nav-icon" content="M4 7 H20 M4 17 H20 M9 4 V10 M15 14 V20"/>
        </graphic>
    </ToggleButton>

    <Region VBox.vgrow="ALWAYS"/>
    <Label styleClass="sidebar-foot" text="ExamDesk 2.0 · JavaFX + FXML"/>
</VBox>
